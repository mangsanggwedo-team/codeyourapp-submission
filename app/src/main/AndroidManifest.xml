<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <!-- 조회·구독 권한만. 제어(CONTROL_*) 권한은 선언하지 않는다. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 차속: Android Automotive 표준 속성 PERF_VEHICLE_SPEED -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 무드등 제어 점검(ControlProbe). 아이디어가 정해지면 필요한 제어 권한만 남긴다 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.App">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.App">
            <!-- 주행 중엔 단순 화면으로 자동 축소하므로 주행 중 표시 허용 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
